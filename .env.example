VITE_API_URL=http://localhost:5080

# Public MediaMTX WebRTC origin. Map a camera UUID (preferred) or camera code to
# its MediaMTX path. This metadata is public and must not contain RTSP URLs or secrets.
VITE_WEBRTC_BASE_URL=https://stream-dev.kitsuracloud.com
VITE_WEBRTC_STREAM_PATHS={"CAM - IP 13 PROMAX":"iphone"}

# Enable only after MediaMTX authentication accepts the application's bearer JWT.
VITE_WEBRTC_USE_APP_TOKEN=false

